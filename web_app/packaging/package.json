{
  "name": "tingyu-shell",
  "version": "1.1.0",
  "private": true,
  "description": "听隅 · Quiet Nook 多端外壳（Capacitor / Electron）",
  "author": "Citro",
  "license": "UNLICENSED",
  "main": "electron/main.cjs",
  "scripts": {
    "sync:web": "node scripts/sync-web.mjs",
    "android:sync": "npm run sync:web && cap sync android",
    "android:apk": "npm run android:sync && cd android && gradlew.bat assembleRelease",
    "android:bundle": "npm run android:sync && cd android && gradlew.bat bundleRelease",
    "ios:sync": "npm run sync:web && cap sync ios",
    "ios:open": "cap open ios",
    "win:build": "npm run sync:web && electron-builder --win --x64",
    "mac:build": "npm run sync:web && electron-builder --mac",
    "smoke:win": "electron . --smoke",
    "win:stage": "node scripts/prepare-win-stage.mjs"
  },
  "dependencies": {
    "@capacitor/android": "7.6.10",
    "@capacitor/core": "7.6.10",
    "@capacitor/ios": "7.6.10",
    "@capacitor/splash-screen": "7.0.5"
  },
  "devDependencies": {
    "@capacitor/cli": "7.6.10",
    "@electron/packager": "^18.4.0",
    "electron": "38.8.6",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.citro.tingyu",
    "productName": "听隅",
    "copyright": "Copyright © 2026 Citro",
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "electron/**/*",
      "www/**/*",
      "resources/icon.png",
      "resources/icon.ico",
      "resources/icon.icns",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico",
      "artifactName": "Tingyu-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "听隅",
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico",
      "installerHeaderIcon": "resources/icon.ico",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "Tingyu-${version}-portable-${arch}.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.lifestyle",
      "icon": "resources/icon.icns",
      "darkModeSupport": true,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null,
      "artifactName": "Tingyu-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "听隅 ${version}"
    }
  }
}
